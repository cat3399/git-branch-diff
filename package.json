{
  "name": "git-branch-diff-local",
  "displayName": "Git Branch Diff (Local)",
  "description": "%extension.description%",
  "version": "0.6.0",
  "publisher": "local",
  "license": "MIT",
  "author": {
    "name": "Firdaus Hatta"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0d1b2a",
    "theme": "dark"
  },
  "pricing": "Free",
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "diff",
    "branch",
    "compare",
    "pull request"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/firdaushatta/git-branch-diff.git"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:branchDiffLocal.filesView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "branch-diff-local",
          "title": "Branch Diff",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "branch-diff-local": [
        {
          "id": "branchDiffLocal.filesView",
          "name": "%view.files%",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "branchDiffLocal.selectSource",
        "title": "%command.selectSource%",
        "icon": "$(git-branch)"
      },
      {
        "command": "branchDiffLocal.selectTarget",
        "title": "%command.selectTarget%",
        "icon": "$(git-compare)"
      },
      {
        "command": "branchDiffLocal.swap",
        "title": "%command.swap%",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "branchDiffLocal.refresh",
        "title": "%command.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "branchDiffLocal.selectComparisonMode",
        "title": "%command.selectComparisonMode%"
      },
      {
        "command": "branchDiffLocal.toggleDiffLayout",
        "title": "%command.toggleDiffLayout%",
        "icon": "$(split-horizontal)",
        "enablement": "branchDiffLocal.diffActive"
      },
      {
        "command": "branchDiffLocal.openChange",
        "title": "%command.openChange%"
      },
      {
        "command": "branchDiffLocal.openFile",
        "title": "%command.openFile%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "branchDiffLocal.openFileAtLine",
        "title": "%command.openFileAtLine%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "branchDiffLocal.copyLineReference",
        "title": "%command.copyLineReference%"
      },
      {
        "command": "branchDiffLocal.copyLine",
        "title": "%command.copyLine%"
      },
      {
        "command": "branchDiffLocal.openToSide",
        "title": "%command.openToSide%",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "branchDiffLocal.copyPath",
        "title": "%command.copyPath%"
      },
      {
        "command": "branchDiffLocal.copyRelativePath",
        "title": "%command.copyRelativePath%"
      },
      {
        "command": "branchDiffLocal.revealInExplorer",
        "title": "%command.revealInExplorer%"
      },
      {
        "command": "branchDiffLocal.excludeEntry",
        "title": "%command.excludeEntry%"
      },
      {
        "command": "branchDiffLocal.restoreExcluded",
        "title": "%command.restoreExcluded%",
        "enablement": "branchDiffLocal.hasExclusions"
      },
      {
        "command": "branchDiffLocal.compareStaged",
        "title": "%command.compareStaged%"
      },
      {
        "command": "branchDiffLocal.compareUnstaged",
        "title": "%command.compareUnstaged%"
      },
      {
        "command": "branchDiffLocal.compareWorkingTree",
        "title": "%command.compareWorkingTree%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "branchDiffLocal.selectTarget",
          "when": "view == branchDiffLocal.filesView",
          "group": "navigation@1"
        },
        {
          "command": "branchDiffLocal.selectSource",
          "when": "view == branchDiffLocal.filesView",
          "group": "navigation@2"
        },
        {
          "command": "branchDiffLocal.swap",
          "when": "view == branchDiffLocal.filesView",
          "group": "navigation@3"
        },
        {
          "command": "branchDiffLocal.refresh",
          "when": "view == branchDiffLocal.filesView",
          "group": "navigation@4"
        },
        {
          "command": "branchDiffLocal.selectComparisonMode",
          "when": "view == branchDiffLocal.filesView",
          "group": "0_mode@0"
        },
        {
          "command": "branchDiffLocal.toggleDiffLayout",
          "when": "view == branchDiffLocal.filesView",
          "group": "0_mode@1"
        },
        {
          "command": "branchDiffLocal.compareStaged",
          "when": "view == branchDiffLocal.filesView",
          "group": "1_compare@0"
        },
        {
          "command": "branchDiffLocal.compareUnstaged",
          "when": "view == branchDiffLocal.filesView",
          "group": "1_compare@1"
        },
        {
          "command": "branchDiffLocal.compareWorkingTree",
          "when": "view == branchDiffLocal.filesView",
          "group": "1_compare@2"
        },
        {
          "command": "branchDiffLocal.restoreExcluded",
          "when": "view == branchDiffLocal.filesView && branchDiffLocal.hasExclusions",
          "group": "2_filter@0"
        }
      ],
      "editor/title": [
        {
          "command": "branchDiffLocal.toggleDiffLayout",
          "when": "isInDiffEditor && branchDiffLocal.diffActive",
          "group": "navigation@20"
        }
      ],
      "editor/context": [
        {
          "command": "branchDiffLocal.openFileAtLine",
          "when": "resourceScheme == branchdiff-local",
          "group": "branchDiff@1"
        },
        {
          "command": "branchDiffLocal.copyLineReference",
          "when": "resourceScheme == branchdiff-local",
          "group": "branchDiff@2"
        },
        {
          "command": "branchDiffLocal.copyLine",
          "when": "resourceScheme == branchdiff-local",
          "group": "branchDiff@3"
        }
      ],
      "commandPalette": [
        {
          "command": "branchDiffLocal.openChange",
          "when": "false"
        },
        {
          "command": "branchDiffLocal.openFile",
          "when": "false"
        },
        {
          "command": "branchDiffLocal.openFileAtLine",
          "when": "false"
        },
        {
          "command": "branchDiffLocal.copyLineReference",
          "when": "false"
        },
        {
          "command": "branchDiffLocal.copyLine",
          "when": "false"
        },
        {
          "command": "branchDiffLocal.openToSide",
          "when": "false"
        },
        {
          "command": "branchDiffLocal.copyPath",
          "when": "false"
        },
        {
          "command": "branchDiffLocal.copyRelativePath",
          "when": "false"
        },
        {
          "command": "branchDiffLocal.revealInExplorer",
          "when": "false"
        },
        {
          "command": "branchDiffLocal.excludeEntry",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "branchDiffLocal.openFile",
          "when": "webviewId == branchDiffLocal.filesView && webviewSection == file",
          "group": "1_open@0"
        },
        {
          "command": "branchDiffLocal.openToSide",
          "when": "webviewId == branchDiffLocal.filesView && webviewSection == file",
          "group": "1_open@1"
        },
        {
          "command": "branchDiffLocal.copyPath",
          "when": "webviewId == branchDiffLocal.filesView && (webviewSection == file || webviewSection == folder)",
          "group": "2_file@0"
        },
        {
          "command": "branchDiffLocal.copyRelativePath",
          "when": "webviewId == branchDiffLocal.filesView && (webviewSection == file || webviewSection == folder)",
          "group": "2_file@1"
        },
        {
          "command": "branchDiffLocal.revealInExplorer",
          "when": "webviewId == branchDiffLocal.filesView && (webviewSection == file || webviewSection == folder)",
          "group": "2_file@2"
        },
        {
          "command": "branchDiffLocal.excludeEntry",
          "when": "webviewId == branchDiffLocal.filesView && (webviewSection == file || webviewSection == folder)",
          "group": "2_file@3"
        },
        {
          "command": "branchDiffLocal.restoreExcluded",
          "when": "webviewId == branchDiffLocal.filesView && branchDiffLocal.hasExclusions",
          "group": "2_file@4"
        }
      ]
    },
    "configuration": {
      "title": "Branch Diff",
      "properties": {
        "branchDiffLocal.useMergeBase": {
          "type": "boolean",
          "scope": "resource",
          "default": false,
          "description": "%setting.useMergeBase%"
        },
        "branchDiffLocal.groupByFolder": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "description": "%setting.groupByFolder%"
        },
        "branchDiffLocal.includeUntracked": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "description": "%setting.includeUntracked%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "pretest": "node esbuild.test.js",
    "test": "node --test dist-test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/codicons": "^0.0.46-24",
    "esbuild": "^0.25.0",
    "typescript": "^5.4.0"
  },
  "l10n": "./l10n",
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
